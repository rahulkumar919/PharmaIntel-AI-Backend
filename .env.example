# ── Copy this file to .env and fill in real values ───────────────────────────
# .env is git-ignored; .env.example is committed so teammates know what's needed.
# NEVER commit your real .env — it contains secrets.

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Model overrides (optional — defaults are set in config.py)
# Groq deprecated gemma2-9b-it (Oct 2025) and llama-3.3-70b-versatile (Aug 2026).
# Current defaults use the official replacements:
#   EXTRACTION_MODEL=openai/gpt-oss-20b       (fast, structured extraction)
#   CAPA_MODEL=openai/gpt-oss-120b            (heavy reasoning for CAPA)

# PostgreSQL connection string (asyncpg dialect)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pharma_complaints

# Application environment — controls debug mode and log verbosity
APP_ENV=development   # options: development | production

# Similarity threshold for duplicate detection (0.0 – 1.0)
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# Completeness gate — fraction of required fields that must be filled
# before the graph skips the ask_user node (0.0 – 1.0)
COMPLETENESS_THRESHOLD=0.75

# CORS — JSON array of allowed origins for the React frontend
# pydantic-settings v2 requires JSON array format for list fields
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# HuggingFace API token — for duplicate detection (free tier embeddings).
# Embeddings are generated via the HuggingFace Inference API instead of
# running sentence-transformers locally (saves ~350 MB RAM on the server).
# Get a free token at: https://huggingface.co → Settings → Access Tokens → New token (Read)
# Without this token the API still works but is rate-limited (~30 req/hr).
HF_API_TOKEN=hf_your_token_here
